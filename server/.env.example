# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/switch_management

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars-long
JWT_EXPIRES_IN=7d

# Credential Encryption Key (32-byte hex string or 32-character string for AES-256-GCM)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# SNMP Trap Receiver (Default standard is 162, use 1162 for non-privileged testing if needed)
SNMP_TRAP_PORT=162
SNMP_TRAP_BIND_ADDRESS=0.0.0.0

# Polling Interval (in minutes for periodic state reconciliation)
POLL_INTERVAL_MINUTES=5

# SMTP Email Configuration for Alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alerts@example.com
SMTP_PASS=app-password-here
ALERT_FROM_EMAIL="Switch Monitoring <alerts@example.com>"
ALERT_TO_EMAIL=admin@example.com
ENABLE_EMAIL_ALERTS=false

# CORS
CORS_ORIGIN=http://localhost:5173
